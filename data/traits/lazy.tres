[ext_resource type="Script" path="res://game/definitions/trait_definition.gd" id="1_trait"]

[resource]
script = ExtResource("1_trait")
id = &"lazy"
display_name = "Lazy"
description = "Trains slowly, rests well. Dislikes back-to-back expeditions."
