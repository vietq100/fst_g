extends TestCase
## Port of the Pixel Hero Forge: palette and composition compared with the original engine
## (tests/fixtures/forge_golden/*.json, generated by tools/character_forge/export_forge.js).

const GOLDEN := "res://tests/fixtures/forge_golden/"


func _load(name: String) -> Dictionary:
	var file := FileAccess.open(GOLDEN + name, FileAccess.READ)
	return JSON.parse_string(file.get_as_text())


func test_ramp_matches_original() -> void:
	var golden := _load("ramp.json")
	for hex: String in golden:
		var r := ForgePalette.ramp(hex)
		for key: String in golden[hex]:
			var want: Array = golden[hex][key]
			for i in 3:
				assert_true(absf(float(r[key][i]) - float(want[i])) < 0.01, "ramp %s.%s[%d]" % [hex, key, i])


func _compare(name: String) -> void:
	var golden := _load("compose.json")
	var entry: Dictionary = golden[name]
	var g := ForgeComposer.compose(entry["cfg"], entry["st"])
	var want: Array = entry["ops"]
	assert_eq(g.ops.size(), want.size(), "%s: op count" % name)
	for i in mini(g.ops.size(), want.size()):
		var got: Array = g.ops[i]
		var w: Array = want[i]
		var same := true
		for j in 3:
			same = same and absf(float(got[j]) - float(w[j])) < 0.001
		for j in 3:
			same = same and absf(floorf(float(got[3 + j]) + 0.5) - float(w[3 + j])) < 0.001
		same = same and absf(float(got[6]) - float(w[6])) < 0.002
		if not same:
			assert_true(false, "%s: op %d differs: %s vs %s" % [name, i, got, w])
			return


func test_core_compose_matches_original() -> void:
	_compare("core")
	_compare("core_blink")


func test_resting_weapons_match_original() -> void:
	for name: String in _load("compose.json"):
		if name.begins_with("weapon_") or name.begins_with("hair_") or name.begins_with("hat_") or name.begins_with("shirt_") \
				or name.begins_with("pants_") or name.begins_with("shoes_") or name.begins_with("glasses_") or name == "preset" or name == "preset_bob":
			_compare(name)


func test_weapon_rows_match_original() -> void:
	var golden := _load("weapons.json")
	for id: String in golden:
		var weapon := ForgeData.find_item("weapon", id)
		var hold: Array = weapon["hold"]
		for angle: String in golden[id]:
			var want: Dictionary = golden[id][angle]
			var part := ForgeShapes.weapon_part(weapon, 2.0, [hold[0], hold[1]], float(angle), {"K": 2.0, "pull": 0.0, "arrow": false})
			assert_eq(part["rows"], want["rows"], "weapon %s at %s" % [id, angle])
